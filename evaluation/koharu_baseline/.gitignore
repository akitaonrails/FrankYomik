outputs/**
reviews/blind/**
reviews/private/**
!outputs/.gitkeep
!reviews/blind/.gitkeep
!reviews/private/.gitkeep

# Local configuration overrides and Python cache.
config.local.json
**/__pycache__/
*.pyc

