# CPU-only worker — no CUDA, smaller image
FROM python:3.12-bookworm@sha256:5560e9ab8709f459489e5b8aa696eda8a07ef821e14bb122be62d91234bfa98b AS builder

WORKDIR /build
COPY server/requirements.txt server/requirements.worker.lock ./
# Install CPU-only PyTorch first, then the rest
RUN pip install --no-cache-dir pip==25.3.1 && \
    pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 \
      --index-url https://download.pytorch.org/whl/cpu && \
    grep -v '^simple-lama' requirements.txt > /tmp/requirements-without-lama.txt && \
    pip install --no-cache-dir -c requirements.worker.lock \
      -r /tmp/requirements-without-lama.txt && \
    pip install --no-cache-dir --no-deps "$(grep '^simple-lama' requirements.txt)"

# Runtime
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

ARG APP_UID=1026
ARG APP_GID=1026
ARG SOURCE_REVISION
ARG PIPELINE_REVISION
ARG RELEASE_VERSION
LABEL org.opencontainers.image.source="https://github.com/akitaonrails/FrankYomik" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      io.frank-yomik.pipeline-revision="${PIPELINE_REVISION}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 gosu \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app/server
COPY server/ .

RUN echo "worker:x:${APP_UID}:${APP_GID}:worker:/home/worker:/usr/sbin/nologin" >> /etc/passwd \
    && echo "worker:x:${APP_GID}:" >> /etc/group \
    && mkdir -p /home/worker/.cache/huggingface \
                /home/worker/.cache/manga_ocr \
                /home/worker/.EasyOCR/model \
                /app/server/cache \
    && chown -R ${APP_UID}:${APP_GID} /home/worker /app

COPY docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh

ENV HOME=/home/worker
ENV HF_HOME=/home/worker/.cache/huggingface
ENV EASYOCR_MODULE_PATH=/home/worker/.EasyOCR

ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
CMD ["--pipeline", "both"]
