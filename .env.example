AUTH_TOKEN=your-secret-token-here

# Ollama running on the docker server
OLLAMA_BASE_URL=http://192.168.0.90:11434

# Match your host user so volumes have correct ownership
APP_UID=1026
APP_GID=1026

# Optional deployment assertion. Leave unset to use the fingerprint derived
# from server/pipeline/stage_manifest.json. A mismatched value stops startup.
# PIPELINE_REVISION=sha256:<64 hex characters>
