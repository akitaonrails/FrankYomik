# ROCm (AMD GPU) worker — based on official ROCm PyTorch image
# PyTorch + ROCm are pre-installed in the base image.
#
# Build:  docker build -f Dockerfile.worker-rocm -t frank-yomik-worker-rocm .
# Run:    docker run --device=/dev/kfd --device=/dev/dri \
#           --group-add video --group-add render \
#           --security-opt seccomp=unconfined --shm-size=8g \
#           frank-yomik-worker-rocm
#
FROM rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1@sha256:96a2fb24dec9896e2f8238178f0c49d0dcc4c7dcc597be09e4564316bd86d191

ARG APP_UID=1026
ARG APP_GID=1026

# Security: upgrade kernel headers baked into the ROCm base (fixes
# linux-libc-dev CVEs incl. CVE-2026-53215) and purge the stale ABI
# header packages the base carries — runtime never needs them. Upstream
# base refreshes lag Ubuntu security fixes, so plain rebuilds don't clear these.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 gosu util-linux \
    && apt-get install -y --only-upgrade linux-libc-dev \
    && { apt-get purge -y linux-headers-6.8.0-106 linux-headers-6.8.0-106-generic || true; } \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY server/requirements.txt server/requirements.worker.lock ./

# The digest-pinned base supplies its matching ROCm builds of torch and
# torchvision. The universal lock also describes the CUDA packages selected by
# PyPI's torch wheel, so exclude that stack and constrain the resolver to the
# ABI pair already supplied by the base.
RUN pip install --no-cache-dir pip==25.3 && \
    python -c 'import torch, torchvision; assert torch.__version__ == "2.9.1+rocm7.2.1.gitff65f5bc"; assert torchvision.__version__ == "0.24.0+rocm7.2.1.gitb919bd0c"' && \
    grep -Ev '^(cuda-|nvidia-|triton==)' requirements.worker.lock > /tmp/requirements.worker-rocm.lock && \
    printf '\ntorch==2.9.1\ntorchvision==0.24.0\n' >> /tmp/requirements.worker-rocm.lock && \
    grep -v '^simple-lama' requirements.txt | \
        grep -vi '^torch' | \
        pip install --no-cache-dir -c /tmp/requirements.worker-rocm.lock -r /dev/stdin && \
    pip install --no-cache-dir --no-deps "$(grep '^simple-lama' requirements.txt)" && \
    python -c 'import torch, torchvision; assert torch.__version__ == "2.9.1+rocm7.2.1.gitff65f5bc"; assert torchvision.__version__ == "0.24.0+rocm7.2.1.gitb919bd0c"' && \
    { pip check 2>&1 | grep -Fvx \
        'simple-lama-inpainting 0.1.0 requires opencv-python, which is not installed.' \
        > /tmp/unexpected-pip-check || true; } && \
    test ! -s /tmp/unexpected-pip-check

# Release identity changes on every build. Keep it after the expensive,
# content-pinned dependency layers so a new source revision can reuse them.
ARG SOURCE_REVISION
ARG PIPELINE_REVISION
ARG RELEASE_VERSION
LABEL org.opencontainers.image.source="https://github.com/akitaonrails/FrankYomik" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      io.frank-yomik.pipeline-revision="${PIPELINE_REVISION}"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app/server
COPY server/ .

RUN echo "worker:x:${APP_UID}:${APP_GID}:worker:/home/worker:/usr/sbin/nologin" >> /etc/passwd \
    && echo "worker:x:${APP_GID}:" >> /etc/group \
    && mkdir -p /home/worker/.cache/huggingface \
                /home/worker/.cache/manga_ocr \
                /home/worker/.EasyOCR/model \
                /app/server/cache \
    && chown -R ${APP_UID}:${APP_GID} /home/worker /app

COPY docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh

ENV HOME=/home/worker
ENV HF_HOME=/home/worker/.cache/huggingface
ENV EASYOCR_MODULE_PATH=/home/worker/.EasyOCR

ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
CMD ["--pipeline", "both"]
