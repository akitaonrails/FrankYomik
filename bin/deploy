#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SERVER="${SERVER:-192.168.0.90}"
SSH_USER="${SSH_USER:-akitaonrails}"
REMOTE_DIR="${REMOTE_DIR:-/var/opt/docker/frank/yomik}"
REMOTE_REGISTRY="${REMOTE_REGISTRY:-${SERVER}:3007/akitaonrails}"
SOURCE_DOCKER_CONFIG="${DOCKER_CONFIG:-${HOME}/.docker}"
TAG="${1:?Usage: bin/deploy <release-tag> [rocm]}"
VARIANT="${2:-rocm}"

if [[ "${TAG}" == *[!A-Za-z0-9._-]* || -z "${TAG}" ]]; then
  echo "Release tag contains unsupported characters: ${TAG}" >&2
  exit 1
fi
if [[ "${TAG}" == "latest" ]]; then
  echo "Refusing the moving tag 'latest'; provide a release version." >&2
  exit 1
fi
if [[ "${VARIANT}" != "rocm" ]]; then
  echo "Remote compose deploys the ROCm worker. Use variant: rocm." >&2
  exit 1
fi

SSH_OPTS=(-F /dev/null)
if [[ -n "${SSH_KNOWN_HOSTS:-}" ]]; then
  SSH_OPTS+=(-o "UserKnownHostsFile=${SSH_KNOWN_HOSTS}")
fi
if [[ "${SSH_STRICT_HOST_KEY_CHECKING:-yes}" == "no" ]]; then
  SSH_OPTS+=(-o StrictHostKeyChecking=no)
fi

ssh_cmd() {
  ssh "${SSH_OPTS[@]}" "${SSH_USER}@${SERVER}" "$@"
}

REGISTRY_FORWARD_DIR=""
REGISTRY_FORWARD_PID=""
REGISTRY_FORWARD_LOG=""
cleanup_registry_forward() {
  if [[ -n "${REGISTRY_FORWARD_PID}" ]]; then
    kill "${REGISTRY_FORWARD_PID}" 2>/dev/null || true
    wait "${REGISTRY_FORWARD_PID}" 2>/dev/null || true
  fi
  if [[ -n "${REGISTRY_FORWARD_DIR}" ]]; then
    rm -rf "${REGISTRY_FORWARD_DIR}"
  fi
}
trap cleanup_registry_forward EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

start_registry_forward() {
  local port relay_code remote_command attempt
  port="${LOCAL_REGISTRY_PORT:-}"
  if [[ -z "${port}" ]]; then
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  fi
  [[ "${port}" =~ ^[0-9]+$ && "${port}" -ge 1024 && "${port}" -le 65535 ]] || {
    echo "LOCAL_REGISTRY_PORT must be an unprivileged TCP port." >&2
    return 1
  }
  REGISTRY_FORWARD_DIR="$(mktemp -d)"
  REGISTRY_FORWARD_LOG="${REGISTRY_FORWARD_DIR}/forward.log"
  cat >"${REGISTRY_FORWARD_DIR}/forward.py" <<'PY'
import os
import select
import signal
import socketserver
import subprocess
import sys
import threading

children: set[subprocess.Popen[bytes]] = set()
children_lock = threading.Lock()
command = sys.argv[3:]

class Handler(socketserver.BaseRequestHandler):
    def handle(self) -> None:
        process = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
        )
        assert process.stdin is not None and process.stdout is not None
        with children_lock:
            children.add(process)
        try:
            while True:
                readable, _, _ = select.select((self.request, process.stdout), (), ())
                if self.request in readable:
                    data = self.request.recv(65536)
                    if not data:
                        return
                    process.stdin.write(data)
                if process.stdout in readable:
                    data = os.read(process.stdout.fileno(), 65536)
                    if not data:
                        return
                    self.request.sendall(data)
        finally:
            process.terminate()
            process.wait(timeout=5)
            with children_lock:
                children.discard(process)

class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = False
    daemon_threads = True

server = Server(("127.0.0.1", int(sys.argv[1])), Handler)
with open(sys.argv[2], "x", encoding="utf-8"):
    pass

def stop(_signum: int, _frame: object) -> None:
    with children_lock:
        active = tuple(children)
    for process in active:
        process.terminate()
    server.server_close()
    raise SystemExit(0)

signal.signal(signal.SIGTERM, stop)
server.serve_forever()
PY
  relay_code="$(python3 -c '
import base64
code = r"""
import os
import select
import socket
import sys

with socket.create_connection((sys.argv[1], int(sys.argv[2]))) as peer:
    inputs = [0, peer]
    while inputs:
        readable, _, _ = select.select(inputs, (), ())
        if 0 in readable:
            data = os.read(0, 65536)
            if data:
                peer.sendall(data)
            else:
                peer.shutdown(socket.SHUT_WR)
                inputs.remove(0)
        if peer in readable:
            data = peer.recv(65536)
            if not data:
                break
            os.write(1, data)
"""
print(base64.b64encode(code.encode()).decode())
')" || return 1
  relay_code="${relay_code//$'\n'/}"
  remote_command="python3 -c 'import base64; exec(base64.b64decode(\"${relay_code}\"))' '${SERVER}' 3007"
  python3 "${REGISTRY_FORWARD_DIR}/forward.py" "${port}" \
    "${REGISTRY_FORWARD_DIR}/ready" \
    ssh "${SSH_OPTS[@]}" "${SSH_USER}@${SERVER}" "${remote_command}" \
    >"${REGISTRY_FORWARD_LOG}" 2>&1 &
  REGISTRY_FORWARD_PID=$!
  for attempt in {1..50}; do
    if ! kill -0 "${REGISTRY_FORWARD_PID}" 2>/dev/null; then
      cat "${REGISTRY_FORWARD_LOG}" >&2
      echo "Registry SSH forward failed to start on port ${port}." >&2
      return 1
    fi
    if [[ -f "${REGISTRY_FORWARD_DIR}/ready" ]]; then
      REGISTRY="localhost:${port}/akitaonrails"
      mkdir -m 700 "${REGISTRY_FORWARD_DIR}/docker-config"
      python3 - "${SOURCE_DOCKER_CONFIG}/config.json" \
        "${SERVER}:3007" "localhost:${port}" \
        "${REGISTRY_FORWARD_DIR}/docker-config/config.json" <<'PY'
import json
import os
import sys

source, source_registry, forwarded_registry, destination = sys.argv[1:]
try:
    with open(source, encoding="utf-8") as handle:
        config = json.load(handle)
    source_auth = config.get("auths", {}).get(source_registry)
    if source_auth is None:
        raise KeyError(source_registry)
    forwarded_config = {"auths": {forwarded_registry: source_auth}}
    with open(destination, "w", encoding="utf-8") as handle:
        json.dump(forwarded_config, handle)
    os.chmod(destination, 0o600)
except (OSError, ValueError, KeyError) as exc:
    raise SystemExit(
        f"Docker credentials for {source_registry} are required: {exc}"
    ) from exc
PY
      DOCKER_CONFIG="${REGISTRY_FORWARD_DIR}/docker-config"
      RELEASE_REGISTRY_URL="http://localhost:${port}"
      RELEASE_REGISTRY_HOST="localhost:${port}"
      export REGISTRY DOCKER_CONFIG RELEASE_REGISTRY_URL RELEASE_REGISTRY_HOST
      return 0
    fi
    sleep 0.1
  done
  echo "Timed out waiting for registry SSH forward on port ${port}." >&2
  return 1
}

resolve_digest() {
  local manifest error_file error_message status
  error_file="$(mktemp)" || return 1
  if manifest="$(docker manifest inspect --insecure --verbose "$1" 2>"${error_file}")"; then
    :
  else
    status=$?
    error_message="$(<"${error_file}")"
    rm -f "${error_file}"
    if [[ "${status}" -eq 1 && "${error_message}" == "manifest unknown" ]]; then
      return 44
    fi
    echo "Registry manifest lookup failed for $1: ${error_message:-exit ${status}}" >&2
    return "${status}"
  fi
  rm -f "${error_file}"
  printf '%s' "${manifest}" | python3 -c '
import json, sys
data = json.load(sys.stdin)
entries = data if isinstance(data, list) else [data]
matches = [
    item["Descriptor"]["digest"]
    for item in entries
    if item.get("Descriptor", {}).get("platform", {}).get("os") == "linux"
    and item["Descriptor"]["platform"].get("architecture") == "amd64"
]
if len(matches) != 1:
    raise SystemExit("registry reference must resolve to exactly one linux/amd64 manifest")
print(matches[0])
' || {
    echo "Registry returned a malformed or ambiguous manifest for $1." >&2
    return 1
  }
}

inspect_local_label() {
  local reference="$1"
  local label="$2"
  docker image inspect "${reference}" \
    --format "{{ index .Config.Labels \"${label}\" }}"
}

verify_local_labels() {
  local reference="$1"
  local actual_source actual_pipeline
  actual_source="$(inspect_local_label "${reference}" org.opencontainers.image.revision)" || return 1
  actual_pipeline="$(inspect_local_label "${reference}" io.frank-yomik.pipeline-revision)" || return 1
  [[ "${actual_source}" == "${SOURCE_REVISION}" ]] || {
    echo "Source revision label mismatch for ${reference}: ${actual_source}" >&2
    return 1
  }
  [[ "${actual_pipeline}" == "${PIPELINE_REVISION}" ]] || {
    echo "Pipeline revision label mismatch for ${reference}: ${actual_pipeline}" >&2
    return 1
  }
}

publish_image() {
  local dockerfile="$1"
  local image_name="$2"
  local image="${REGISTRY}/${image_name}"
  local release_ref="${image}:${TAG}"
  local candidate_tag="candidate-${SOURCE_REVISION:0:12}-${BASHPID}-$RANDOM"
  local candidate_ref="${image}:${candidate_tag}"
  local existing_digest release_digest status

  # This function runs in command substitution. Its EXIT trap removes every
  # local tag whether publishing succeeds or fails.
  trap "docker image rm '${candidate_ref}' '${release_ref}' >/dev/null 2>&1 || true" EXIT

  if existing_digest="$(resolve_digest "${release_ref}")"; then
    docker pull "${release_ref}" >&2 || return 1
    verify_local_labels "${release_ref}" || {
      echo "Existing release tag does not belong to this source and pipeline revision: ${release_ref}" >&2
      return 1
    }
    printf '%s\n' "${existing_digest}"
    return 0
  else
    status=$?
    if [[ "${status}" -ne 44 ]]; then
      return "${status}"
    fi
  fi

  docker build -f "${dockerfile}" \
    --build-arg "SOURCE_REVISION=${SOURCE_REVISION}" \
    --build-arg "PIPELINE_REVISION=${PIPELINE_REVISION}" \
    --build-arg "RELEASE_VERSION=${TAG}" \
    -t "${candidate_ref}" . >&2 || return 1
  verify_local_labels "${candidate_ref}" || return 1
  docker tag "${candidate_ref}" "${release_ref}" || return 1
  docker push "${release_ref}" >&2 || return 1

  release_digest="$(resolve_digest "${release_ref}")" || return 1
  [[ "${release_digest}" =~ ^sha256:[0-9a-f]{64}$ ]] || {
    echo "Registry returned an invalid digest for ${release_ref}" >&2
    return 1
  }
  printf '%s\n' "${release_digest}"
}

sync_remote_file() {
  local local_path="$1"
  local remote_name="$2"
  local expected_sha remote_tmp
  expected_sha="$(sha256sum "${local_path}" | awk '{print $1}')" || return 1
  remote_tmp=".${remote_name}.release-${BASHPID}"
  ssh_cmd "set -eu; cd '${REMOTE_DIR}'; tmp='${remote_tmp}'; \
    trap 'rm -f \"\$tmp\"' EXIT; cat >\"\$tmp\"; \
    actual=\$(sha256sum \"\$tmp\" | awk '{print \$1}'); \
    test \"\$actual\" = '${expected_sha}'; chmod 0644 \"\$tmp\"; \
    mv -f -- \"\$tmp\" '${remote_name}'; trap - EXIT; \
    test \"\$(sha256sum '${remote_name}' | awk '{print \$1}')\" = '${expected_sha}'" \
    <"${local_path}"
}

cd "${ROOT}"
if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  echo "Refusing release build from a dirty worktree." >&2
  exit 1
fi
SOURCE_REVISION="$(git rev-parse --verify HEAD)"
REVISION_PYTHON="${REVISION_PYTHON:-${ROOT}/server/.venv/bin/python}"
if [[ ! -x "${REVISION_PYTHON}" ]]; then
  REVISION_PYTHON="python3"
fi
PIPELINE_REVISION="$(PYTHONPATH="${ROOT}/server" "${REVISION_PYTHON}" -c \
  'from pipeline.revision import get_pipeline_revision; print(get_pipeline_revision())')" || exit 1
[[ "${PIPELINE_REVISION}" =~ ^sha256:[0-9a-f]{64}$ ]] || {
  echo "Could not derive a valid pipeline revision." >&2
  exit 1
}

if [[ -z "${REGISTRY:-}" ]]; then
  echo "==> Opening temporary SSH forward to the homelab registry"
  start_registry_forward
fi

echo "==> Building and publishing API image"
API_DIGEST="$(publish_image Dockerfile.api frank-yomik-api)" || exit 1
echo "==> Building and publishing ROCm worker image"
WORKER_DIGEST="$(publish_image Dockerfile.worker-rocm frank-yomik-worker-rocm)" || exit 1

API_PUSH_REF="${REGISTRY}/frank-yomik-api@${API_DIGEST}"
WORKER_PUSH_REF="${REGISTRY}/frank-yomik-worker-rocm@${WORKER_DIGEST}"
API_IMAGE="${REMOTE_REGISTRY}/frank-yomik-api@${API_DIGEST}"
WORKER_IMAGE="${REMOTE_REGISTRY}/frank-yomik-worker-rocm@${WORKER_DIGEST}"

echo "==> Atomically syncing verified production descriptors"
sync_remote_file docker-compose.prod.yml docker-compose.prod.yml
sync_remote_file docker-compose.v1-rollback.yml docker-compose.v1-rollback.yml
sync_remote_file config.prod.yaml config.prod.yaml

echo "==> Pulling and verifying exact release digests on ${SERVER}"
ssh_cmd "set -eu; docker pull '${API_IMAGE}' >/dev/null; docker pull '${WORKER_IMAGE}' >/dev/null; \
  case \"\$(docker image inspect '${API_IMAGE}' --format '{{json .RepoDigests}}')\" in *'${API_DIGEST}'*) ;; *) exit 1 ;; esac; \
  case \"\$(docker image inspect '${WORKER_IMAGE}' --format '{{json .RepoDigests}}')\" in *'${WORKER_DIGEST}'*) ;; *) exit 1 ;; esac; \
  test \"\$(docker image inspect '${API_IMAGE}' --format '{{ index .Config.Labels \"org.opencontainers.image.revision\" }}')\" = '${SOURCE_REVISION}'; \
  test \"\$(docker image inspect '${API_IMAGE}' --format '{{ index .Config.Labels \"io.frank-yomik.pipeline-revision\" }}')\" = '${PIPELINE_REVISION}'; \
  test \"\$(docker image inspect '${WORKER_IMAGE}' --format '{{ index .Config.Labels \"org.opencontainers.image.revision\" }}')\" = '${SOURCE_REVISION}'; \
  test \"\$(docker image inspect '${WORKER_IMAGE}' --format '{{ index .Config.Labels \"io.frank-yomik.pipeline-revision\" }}')\" = '${PIPELINE_REVISION}'"

echo "==> Recreating API and two workers without restarting Redis or tunnel"
ssh_cmd "cd '${REMOTE_DIR}' && API_IMAGE='${API_IMAGE}' WORKER_IMAGE='${WORKER_IMAGE}' \
  PIPELINE_REVISION='${PIPELINE_REVISION}' docker compose -f docker-compose.prod.yml \
  up -d --no-deps --force-recreate --scale worker=2 api worker"

echo "==> Verifying deployed container image digests"
ssh_cmd "set -eu; cd '${REMOTE_DIR}'; \
  test \"\$(docker inspect yomik-api --format '{{.Image}}')\" = \"\$(docker image inspect '${API_IMAGE}' --format '{{.Id}}')\"; \
  workers=\$(API_IMAGE='${API_IMAGE}' WORKER_IMAGE='${WORKER_IMAGE}' PIPELINE_REVISION='${PIPELINE_REVISION}' \
    docker compose -f docker-compose.prod.yml ps -q worker); \
  test \"\$(printf '%s\n' \${workers} | sed '/^$/d' | wc -l)\" -eq 2; \
  for container in \${workers}; do test \"\$(docker inspect \${container} --format '{{.Image}}')\" = \"\$(docker image inspect '${WORKER_IMAGE}' --format '{{.Id}}')\"; done"

MANIFEST_DIR="${RELEASE_MANIFEST_DIR:-${ROOT}/release-manifests}"
MANIFEST_PATH="${MANIFEST_DIR}/${TAG}.json"
mkdir -p "${MANIFEST_DIR}"
export TAG SOURCE_REVISION PIPELINE_REVISION API_DIGEST WORKER_DIGEST API_PUSH_REF WORKER_PUSH_REF API_IMAGE WORKER_IMAGE MANIFEST_PATH
python3 - <<'PY'
import datetime
import json
import os
from pathlib import Path

record = {
    "schema_version": 1,
    "release_tag": os.environ["TAG"],
    "created_at": datetime.datetime.now(datetime.UTC).isoformat(),
    "source_revision": os.environ["SOURCE_REVISION"],
    "pipeline_revision": os.environ["PIPELINE_REVISION"],
    "images": {
        "api": {
            "published": os.environ["API_PUSH_REF"],
            "deployed": os.environ["API_IMAGE"],
            "digest": os.environ["API_DIGEST"],
        },
        "worker": {
            "published": os.environ["WORKER_PUSH_REF"],
            "deployed": os.environ["WORKER_IMAGE"],
            "digest": os.environ["WORKER_DIGEST"],
        },
    },
}
path = Path(os.environ["MANIFEST_PATH"])
path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
PY
ssh_cmd "mkdir -p '${REMOTE_DIR}/release-manifests' && cat > '${REMOTE_DIR}/release-manifests/${TAG}.json'" < "${MANIFEST_PATH}"

echo "==> Release manifest: ${MANIFEST_PATH}"
echo "==> Current status"
ssh_cmd "cd '${REMOTE_DIR}' && API_IMAGE='${API_IMAGE}' WORKER_IMAGE='${WORKER_IMAGE}' \
  PIPELINE_REVISION='${PIPELINE_REVISION}' docker compose -f docker-compose.prod.yml ps"

echo "==> Removing obsolete Frank Yomik release artifacts"
if [[ -n "${RELEASE_REGISTRY_URL:-}" && -n "${RELEASE_REGISTRY_HOST:-}" ]]; then
  "${ROOT}/bin/release-cleanup" --apply \
    --registry-url "${RELEASE_REGISTRY_URL}" \
    --registry-host "${RELEASE_REGISTRY_HOST}" \
    --registry-owner "${REGISTRY#*/}"
else
  "${ROOT}/bin/release-cleanup" --apply --skip-registry
fi
